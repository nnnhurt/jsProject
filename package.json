{
  "name": "dog-explorer-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dog Explorer API - Express + TypeScript + MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
